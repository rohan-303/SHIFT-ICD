# Python
__pycache__/
*.py[cod]
*.so
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Environments
.venv/
venv/
env/

# Local configuration and secrets
.env
.env.*
!.env.example

# Data and generated outputs
# Raw downloads stay out of Git; provenance manifests and lightweight audit JSON stay tracked.
data/raw/*
!data/raw/cms/
data/raw/cms/*
!data/raw/cms/2018_gem/
data/raw/cms/2018_gem/*
!data/raw/cms/2018_gem/manifest.json
data/interim/*
data/processed/*
!data/processed/cms/
!data/processed/cms/2018_gem/
data/processed/cms/2018_gem/*
!data/processed/cms/2018_gem/manifest.json
# Benchmark outputs are reproducible derived data; keep large JSONL files out of Git.
data/benchmarks/*
!data/benchmarks/cms_track_a/
!data/benchmarks/cms_track_a/v1.0/
data/benchmarks/cms_track_a/v1.0/*
!data/benchmarks/cms_track_a/v1.0/manifest.json
data/external/*
artifacts/*
!artifacts/data_audit/
!artifacts/data_audit/*.json
!artifacts/experiments/
artifacts/experiments/bm25_v1/
artifacts/experiments/bm25_v1_1/
!artifacts/experiments/dense_v1/
artifacts/experiments/dense_v1/rankings/
artifacts/experiments/dense_v1/*.npy
!artifacts/embeddings/
artifacts/embeddings/dense_v1/*
!artifacts/embeddings/dense_v1/*.json
reports/figures/*
!reports/figures/dense_v1/
!reports/figures/dense_v1/*.png
reports/tables/*
!reports/tables/dense_v1/
!reports/tables/dense_v1/*.csv
reports/error_analysis/*

# Notebooks' transient state
.ipynb_checkpoints/

# OS/editor files
.DS_Store
Thumbs.db
.vscode/
